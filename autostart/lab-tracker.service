[Unit]
Description=Lab Tracker - 实验室科研时间记录守护进程
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# pip 装过就是这一行；从源码跑改成：
#   ExecStart=/usr/bin/python3 -m smallgalaxy.lab_tracker
#   WorkingDirectory=%h/small-galaxy
ExecStart=%h/.local/bin/small-galaxy-daemon
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.lab_tracker/lab_tracker.log
StandardError=append:%h/.lab_tracker/lab_tracker.log

[Install]
WantedBy=graphical-session.target
